/.bundle/
!/.bundle/config
/.yardoc
/_yardoc/
/coverage/
/pkg/
*.gem
/spec/reports/
/tmp/
/log/

# rspec failure tracking
.rspec_status

# Appraisal resolves these per machine and per CI run. Pinning them would mean
# the matrix proves the gem works with one exact set of transitive dependencies
# rather than across the range it claims to support — the .gemfile files carry
# the arbre/activesupport combinations we actually mean to test.
gemfiles/*.gemfile.lock

# demo app — runtime artifacts
demo/db/*.sqlite3
demo/db/*.sqlite3-*
demo/log/
demo/tmp/

# Arbex reference docs — project context, not gem content
docs/arbex/

# docker volumes (data is stored in named volumes, not tracked in git)
.docker/
